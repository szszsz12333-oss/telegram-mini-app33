# Required for real Telegram authorization and bot messages.
BOT_TOKEN=123456:replace_with_your_bot_token

# Telegram user IDs that may run /confirm, /reject and /orders.
ADMIN_IDS=123456789

# The current payment instructions sent only by the bot after order creation.
PAYMENT_DETAILS=Картка: 0000 0000 0000 0000\nОтримувач: Ваше ім'я

# Secret that your payment-crediting system sends in X-Payment-Webhook-Secret.
# Use a long random value and never put it into frontend files.
PAYMENT_WEBHOOK_SECRET=replace_with_a_long_random_secret

# Public Mini App origin. Keep it exact, without a final slash.
APP_ORIGIN=https://your-github-name.github.io

# Public URL of the Mini App and optional support username (without @).
MINI_APP_URL=https://telegram-mini-app33.onrender.com/
SUPPORT_USERNAME=your_support_username

# Maximum accepted age of Telegram initData. Default: 86400 (24 hours).
INIT_DATA_MAX_AGE_SECONDS=86400

# Optional server port.
PORT=3000

# Folder for orders and access records. Use a persistent disk in production.
# Example for Render: /var/data
DATA_DIR=runtime

# Only for a local test. Never set to true in production.
ALLOW_DEMO_ORDERS=false
